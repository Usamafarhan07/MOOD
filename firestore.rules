rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the resource
    function isOwnUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Helper function for admin check (custom claim)
    function hasAdminClaim() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // Products collection - public read, admin write only
    match /products/{productId} {
      allow read: if true; // Public read access
      allow create, update: if hasAdminClaim()
                   && request.resource.data.keys().hasAll(['title', 'imageUrl', 'price'])
                   && request.resource.data.title is string
                   && request.resource.data.imageUrl is string
                   && (request.resource.data.price is int || request.resource.data.price is float || request.resource.data.price is string);
      allow delete: if hasAdminClaim();
    }

    // Users collection - user owns their data
    match /users/{uid} {
      allow read: if isOwnUser(uid);
      allow create: if isOwnUser(uid) 
                    && request.resource.data.keys().hasAll(['uid', 'email', 'fullName', 'createdAt'])
                    && (!request.resource.data.keys().hasAny(['uid']) || request.resource.data.uid == uid)
                    && request.resource.data.email == request.auth.token.email;
      allow update: if isOwnUser(uid) 
                    && request.resource.data.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'phone', 'address', 'email', 'profileImageBase64', 'paymentMethod', 'updatedAt'])
                    && (!request.resource.data.keys().hasAny(['fullName']) || request.resource.data.fullName is string)
                    && (!request.resource.data.keys().hasAny(['phone']) || request.resource.data.phone is string)
                    && (!request.resource.data.keys().hasAny(['address']) || request.resource.data.address is string)
                    && (request.resource.data.email == null || request.resource.data.email is string)
                    && (request.resource.data.profileImageBase64 == null || request.resource.data.profileImageBase64 is string)
                    && (!request.resource.data.keys().hasAny(['paymentMethod']) || (
                      request.resource.data.paymentMethod is map
                      && request.resource.data.paymentMethod.brand == 'Visa'
                      && request.resource.data.paymentMethod.cardholderName is string
                      && request.resource.data.paymentMethod.last4.matches('^[0-9]{4}$')
                      && request.resource.data.paymentMethod.expiryMonth.matches('^(0[1-9]|1[0-2])$')
                      && request.resource.data.paymentMethod.expiryYear.matches('^[0-9]{2}$')
                    ));
      allow delete: if false; // Users cannot delete their own profile

      // Cart subcollection - user owns their cart
      match /cart/{cartItemId} {
        allow read: if isOwnUser(uid);
        allow create: if isOwnUser(uid) 
                      && request.resource.data.keys().hasAll(['productId', 'title', 'price', 'quantity', 'addedAt'])
                      && request.resource.data.quantity > 0
                      && request.resource.data.price > 0
                      && request.resource.data.productId is string
                      && request.resource.data.title is string;
        allow update: if isOwnUser(uid) 
                      && request.resource.data.productId == resource.data.productId
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'addedAt'])
                      && request.resource.data.quantity > 0;
        allow delete: if isOwnUser(uid);
      }

      // Wishlist subcollection - user owns their wishlist
      match /wishlist/{wishlistItemId} {
        allow read: if isOwnUser(uid);
        allow create: if isOwnUser(uid) 
                      && request.resource.data.keys().hasAll(['productId', 'title', 'price', 'addedAt'])
                      && request.resource.data.price > 0
                      && request.resource.data.productId is string
                      && request.resource.data.title is string;
        allow update: if isOwnUser(uid) 
                      && request.resource.data.productId == resource.data.productId
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['addedAt']);
        allow delete: if isOwnUser(uid);
      }
    }

    // Orders collection - users can read/create their own orders, admins can manage all
    match /orders/{orderId} {
      // Users can read their own orders
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || hasAdminClaim());
      
      // Users can create their own orders
      allow create: if isAuthenticated() 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.userEmail == request.auth.token.email
                    && request.resource.data.keys().hasAll(['userId', 'userEmail', 'items', 'totalPrice', 'subtotal', 'shippingFee', 'orderStatus', 'createdAt', 'paymentMethod', 'shippingAddress'])
                    && request.resource.data.totalPrice > 0
                    && request.resource.data.subtotal > 0
                    && request.resource.data.shippingFee >= 0
                    && request.resource.data.items.size() > 0
                    && request.resource.data.orderStatus == 'pending'
                    && request.resource.data.shippingAddress is map
                    && request.resource.data.shippingAddress.keys().hasAll(['fullName', 'phone', 'address', 'city', 'postalCode'])
                    && request.resource.data.paymentMethod is string
                    && validateOrderItems(request.resource.data.items);
      
      // Admin can update order status only
      allow update: if hasAdminClaim()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['orderStatus', 'updatedAt'])
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.orderStatus in ['pending', 'confirmed', 'shipped', 'delivered', 'cancelled'];
      
      // No deletes allowed for orders (audit trail preservation)
      allow delete: if false;

      // Validate order item structure
      function validateOrderItems(items) {
        return items.size() > 0
               && items.filter(
                 item, item.keys().hasAll(['productId', 'title', 'quantity', 'unitPrice'])
                 && item.quantity > 0
                 && item.unitPrice > 0
                 && item.productId is string
                 && item.title is string
               ).size() == items.size();
      }
    }

    // Default deny rule - deny all access not explicitly allowed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
